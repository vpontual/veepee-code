# VEEPEE Code — copy to ~/.veepee-code/.env (or let `vcode --wizard` write it).
# Endpoints and secrets only; everything else lives in ~/.veepee-code/settings.json.

# ── Where the models are ──────────────────────────────────────────────
# ollama = Ollama API (/api/chat) via VEEPEE_CODE_PROXY_URL
# openai = an OpenAI-compatible server (vLLM, llama.cpp, LM Studio) at VEEPEE_CODE_OPENAI_BASE_URL
VEEPEE_CODE_LLM_BACKEND=ollama

# Ollama server or llm-gateway. With the openai backend, leave it EMPTY for
# "no gateway", or set it to reach models the direct server does not serve.
VEEPEE_CODE_PROXY_URL=http://localhost:11434

# Direct OpenAI-compatible server (openai backend). /v1 is added if missing.
VEEPEE_CODE_OPENAI_BASE_URL=
# Only if the server was started with --api-key.
VEEPEE_CODE_OPENAI_API_KEY=

# Optional: Ollama Fleet Manager dashboard.
VEEPEE_CODE_DASHBOARD_URL=

# ── Local API / Remote Connect ────────────────────────────────────────
VEEPEE_CODE_API_TOKEN=

# ── Tools ─────────────────────────────────────────────────────────────
SEARXNG_URL=
AGENTLENS_URL=

# Remote agent bridge (remote.allow stays in settings.json)
VEEPEE_CODE_REMOTE_URL=
VEEPEE_CODE_REMOTE_API_KEY=

# WebDAV session sync (sync.auto stays in settings.json)
VEEPEE_CODE_SYNC_URL=
VEEPEE_CODE_SYNC_USER=
VEEPEE_CODE_SYNC_PASS=

# Langfuse tracing
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=
